# Non-secret local development settings. The PostgreSQL URL is intentionally absent
# until the isolated database role and service have been created.
JOURNALWICK_ENVIRONMENT=development
JOURNALWICK_PUBLIC_ORIGIN=http://localhost:5203
JOURNALWICK_WEBAUTHN_RP_ID=localhost
JOURNALWICK_PROVIDER_MODE=fixture
JOURNALWICK_KEY_PROVIDER=ephemeral_fixture
JOURNALWICK_PROCESS_ROLE=api
